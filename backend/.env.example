PORT=7860

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/stayfitai?retryWrites=true&w=majority

# Google Gemini AI API Key
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy...

# Clerk Publishable Key (Optional check for backend logging)
CLERK_PUBLISHABLE_KEY=pk_test_...
